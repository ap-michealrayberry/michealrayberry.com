/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self)

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=3600

/*.json
  Cache-Control: public, max-age=3600


/ap/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Generated record media. Filenames encode day, angle, date and width, so a
# given URL's bytes never change — a new photo produces a new filename.
/media/*
  Cache-Control: public, max-age=31536000, immutable

# Mirrored source photos are equally immutable once committed by the script.
/photos/*
  Cache-Control: public, max-age=31536000, immutable

# Permanent daily pages: stable, but revalidate daily so prev/next links to
# newly published days appear without waiting out a long cache.
/daily/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Sitemaps are rewritten on every publish run.
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/sitemap-*.xml
  Cache-Control: public, max-age=0, must-revalidate

# dc-import components. They are building blocks of index.html, not standalone
# pages — keep them out of the index so they cannot surface as partial results.
/*.dc.html
  X-Robots-Tag: noindex, nofollow
