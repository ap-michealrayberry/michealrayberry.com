{
  "profile": "tabular-data-package",
  "name": "mrb-public-progress",
  "title": "Micheal Ray Berry public progress",
  "description": "Public project-day and weigh-in records. Private evidence, violation evidence, consequence amounts, credentials, and Appendix A details are excluded.",
  "homepage": "https://michealrayberry.com/progress/",
  "version": "1.0.0",
  "licenses": [],
  "resources": [
    {
      "name": "public-progress",
      "path": "https://michealrayberry.com/api/public/progress.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "project_day", "type": "integer", "constraints": { "required": true, "minimum": 1 } },
          { "name": "date", "type": "date", "constraints": { "required": true } },
          { "name": "weight_lb", "type": "number", "constraints": { "required": true, "minimum": 1 } },
          { "name": "note", "type": "string" }
        ],
        "primaryKey": "date"
      }
    }
  ]
}
