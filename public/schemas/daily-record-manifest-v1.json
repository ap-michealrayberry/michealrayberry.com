{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michealrayberry.com/schemas/daily-record-manifest-v1.json",
  "title": "Micheal Ray Berry daily record manifest",
  "type": "object",
  "required": ["schema", "person", "project", "record", "photos"],
  "properties": {
    "schema": { "const": "https://michealrayberry.com/schemas/daily-record-manifest-v1.json" },
    "person": {
      "type": "object",
      "required": ["name", "id"],
      "properties": { "name": { "type": "string" }, "id": { "type": "string", "format": "uri" } },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["name", "start_date", "start_weight_lb", "goal_weight_lb"],
      "properties": {
        "name": { "type": "string" },
        "start_date": { "type": "string", "format": "date" },
        "start_weight_lb": { "type": "number" },
        "goal_weight_lb": { "type": "number" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["date", "day", "weight_lb", "note", "video_url", "canonical_url", "attestation"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "day": { "type": "integer", "minimum": 1 },
        "weight_lb": { "type": "number" },
        "note": { "type": "string" },
        "video_url": { "type": "string", "format": "uri" },
        "canonical_url": { "type": "string", "format": "uri" },
        "attestation": {
          "oneOf": [
            { "const": "VALID-CONSUMED" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "photos": {
      "type": "object",
      "required": ["front", "left", "rear", "right"],
      "properties": {
        "front": { "$ref": "#/$defs/photo" },
        "left": { "$ref": "#/$defs/photo" },
        "rear": { "$ref": "#/$defs/photo" },
        "right": { "$ref": "#/$defs/photo" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "responsivePhoto": {
      "type": "object",
      "required": ["url", "width", "height", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "photo": {
      "type": "object",
      "required": ["url", "width", "height", "sha256", "responsive"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "responsive": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/responsivePhoto" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
