# Cloudflare Pages serves the site from the repo root. The typo domain
# (michaelrayberry.com) is redirected at the Cloudflare edge: Rules → Redirect
# Rules → dynamic 301 to https://michealrayberry.com + path. Not here.

/home        /            301
# Every public page is a static file generated at build time from
# site.template.html — no client-side rendering, no SPA rewrites.
/accountability-partner  /  301
/personal    /  301
/personal/*  /  301
/partner     /  301
/partner/*   /  301
/log         /penalties   301
/annex/* / 301
/annex / 301
/fagspose/* / 301
/fagspose / 301
/protocol/* / 301
/protocol / 301

# The capture instrument is /assistant/ — one tool, five sessions. Every old
# tool path and the retired portal funnel there.
/corrective    /assistant/   301
/weekly        /assistant/   301
/confirmation  /assistant/   301
/record        /assistant/   301
/record/*      /assistant/   301
/mrb           /assistant/   301
/ap            /             301
/ap/*          /             301
/mrb/*         /assistant/   301
/inspection    /assistant/   301
/portal        /assistant/   301
/resolution    /assistant/   301
/Corner%20Time.dc.html               /assistant/  301
/Violation%20Acknowledgment.dc.html  /assistant/  301

# Build-only inputs live in the repo but are not part of the served record.
# (The build runs before publishing, so 404-ing them here does not affect it.)
/violations/v-000/ /penalties 301
/violations/v-000 /penalties 301

/scripts/*     /404.html   404
/site.template.html /404.html 404
/package.json  /404.html   404
/voice-pack.json /404.html 404
/eslint.config.mjs /404.html 404

