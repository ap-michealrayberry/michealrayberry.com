{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michealrayberry.com/schemas/daily-record-manifest-v2.json",
  "title": "MRB Daily Record Manifest (v2)",
  "description": "One normalized manifest per Project Day of the Micheal Ray Berry Public Accountability Project. Every public artifact (daily pages, indexes, published.json, weekly and milestone pages, RSS, sitemaps, homepage record data) is generated from these manifests and from nothing else.",
  "type": "object",
  "required": ["schema_version", "date", "day", "weight_lb", "note", "status", "status_reason", "canonical_url", "published_at", "last_verified_at", "media", "history"],
  "properties": {
    "schema_version": { "const": 2 },
    "schema": { "type": "string", "format": "uri" },
    "project": { "type": "object" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Project date (America/New_York calendar day)." },
    "day": { "type": "integer", "minimum": 1, "description": "Project Day number counted from 2026-07-20 = Day 1." },
    "weight_lb": { "type": ["number", "null"] },
    "note": { "type": "string" },
    "status": { "enum": ["complete", "partial", "missing", "violation"] },
    "status_reason": { "type": "string", "minLength": 1 },
    "canonical_url": { "type": "string", "format": "uri" },
    "published_at": { "type": "string", "description": "First publication timestamp of this day's normalized manifest." },
    "last_verified_at": { "type": "string", "description": "Timestamp of the last verification pass." },
    "source": {
      "type": "object",
      "properties": {
        "sheet_id": { "type": "string" },
        "sheet_row": { "type": ["integer", "null"] },
        "source_fetched_at": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "required": ["photos", "video"],
      "properties": {
        "photos": {
          "type": "object",
          "required": ["front", "left", "rear", "right"],
          "properties": {
            "front": { "$ref": "#/$defs/photo" },
            "left": { "$ref": "#/$defs/photo" },
            "rear": { "$ref": "#/$defs/photo" },
            "right": { "$ref": "#/$defs/photo" }
          }
        },
        "video": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["original_source_url", "url"],
              "properties": {
                "original_source_url": { "type": "string", "format": "uri" },
                "url": { "type": "string", "pattern": "^https://" },
                "content_type": { "type": ["string", "null"] },
                "verified": {
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "required": ["at", "method", "content_type"],
                      "properties": {
                        "at": { "type": "string" },
                        "method": { "enum": ["http", "operator-attested", "carried-from-record"] },
                        "http_status": { "type": ["integer", "null"] },
                        "content_type": { "type": "string", "pattern": "^video/" },
                        "accept_ranges": { "type": "boolean" },
                        "bytes": { "type": ["integer", "null"] }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "attestation": { "type": ["object", "null"] },
    "violation": { "type": ["object", "null"] },
    "ingest_errors": { "type": "array", "items": { "type": "string" } },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "status", "reason"],
        "properties": {
          "at": { "type": "string" },
          "status": { "enum": ["complete", "partial", "missing", "violation"] },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "photo": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["position", "url", "path", "content_type", "bytes", "sha256", "width", "height", "responsive"],
          "properties": {
            "position": { "enum": ["front", "left", "rear", "right"] },
            "original_source_url": { "type": ["string", "null"], "description": "URL the spreadsheet supplied; never used as the permanent public image when it is a third-party (e.g. Drive thumbnail) URL." },
            "url": { "type": "string", "pattern": "^https://michealrayberry\\.com/" },
            "path": { "type": "string" },
            "content_type": { "type": "string", "pattern": "^image/" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "exif_orientation": { "type": ["integer", "null"] },
            "responsive": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["url", "path", "width", "height", "bytes", "sha256"]
              }
            }
          }
        }
      ]
    }
  }
}
