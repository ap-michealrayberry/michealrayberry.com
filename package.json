{
  "name": "mrb",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply mrb-record --local",
    "db:migrate:remote": "wrangler d1 migrations apply mrb-record --remote",
    "import-sheets": "node scripts/import-sheets.mjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true
  }
}
